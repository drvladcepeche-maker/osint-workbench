{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,

    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true,

    "noEmit": true,
    // Mirrors the aliases in electron.vite.config.ts. Paths must be relative:
    // TypeScript 7 removed `baseUrl`.
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@renderer/*": ["./src/renderer/src/*"]
    }
  },
  "include": ["src/renderer/**/*.ts", "src/renderer/**/*.tsx", "src/shared/**/*.ts", "src/renderer/src/env.d.ts"],
  // src/shared/ids.ts imports node:crypto and is main-process-only. Excluding it here —
  // rather than adding "node" to the renderer's types — is what keeps the renderer
  // unable to reach node APIs: if a component ever imports it, this typecheck fails.
  "exclude": ["src/shared/ids.ts"]
}
