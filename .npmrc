fund=false
audit=false

# Optional: keep the large downloads off a small system drive by exporting these in your
# shell BEFORE `npm ci` (npm rejects unknown keys here, so they cannot live in this file):
#
#   PowerShell:  $env:ELECTRON_CACHE = "D:\caches\electron"
#   bash:        export ELECTRON_CACHE=/path/to/electron-cache
#
# If `npm run dev` fails with "Error: Electron uninstall", the binary was never
# downloaded: run `node node_modules/electron/install.js`.
